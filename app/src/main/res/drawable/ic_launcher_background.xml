<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: the teal the app is built around, sliding into a near-black of the
  same hue — the same relationship the in-app hero card uses, so the launcher icon reads as the
  same product. Fills the whole 108dp canvas, as an adaptive background must.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6" android:startY="0"
                android:endX="102" android:endY="108">
                <item android:offset="0" android:color="#12A79B" />
                <item android:offset="1" android:color="#04302D" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
