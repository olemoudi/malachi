    <string name="lists_about">%1$s · about %2$s domains</string>
    <string name="list_adguard_dns">Ads and trackers, tuned for DNS blocking and deliberately conservative. The best single list to start from.</string>
    <string name="list_adaway">Mobile ad providers, small and specific. Catches in-app ad SDKs a desktop-derived list can miss.</string>
    <string name="list_easyprivacy">The tracking half of EasyList: analytics, beacons and telemetry.</string>
    <string name="list_yoyo">A long-running, hand-curated list of ad and tracking servers.</string>
    <string name="list_oisd_small">\"Block, don\'t break\" — a widely used general list that avoids anything known to cause trouble.</string>
    <string name="list_oisd_big">The full OISD list. Much broader, and more likely to need an exception now and then.</string>
    <string name="list_hagezi_pro">Ads, tracking, telemetry, scam and crypto-mining domains in one large list.</string>
    <string name="list_hagezi_tif">Phishing, malware and fraud domains from threat-intelligence feeds. Very large.</string>
    <string name="list_stevenblack">The unified hosts file: several well-known sources merged and de-duplicated.</string>
    <string name="list_someonewhocares">A hand-maintained hosts file, curated for decades.</string>
    <string name="list_unknown">A subscribed list.</string>

    <!-- Settings: what a blocked lookup answers -->
    <string name="settings_block_answer_title">Answer for blocked lookups</string>
    <string name="settings_block_answer_hint">What an app is told when Malachi refuses a domain. If something behaves oddly, this is the first thing to try.</string>
    <string name="block_answer_null">Empty address</string>
    <string name="block_answer_null_hint">The app believes the name resolved and fails to connect. Most ad code gives up quietly. Recommended.</string>
    <string name="block_answer_nxdomain">Name does not exist</string>
    <string name="block_answer_nxdomain_hint">Cleaner in theory, but some apps read it as a broken network and retry in a loop.</string>
    <string name="block_answer_refused">Refused</string>
    <string name="block_answer_refused_hint">Unambiguous when you are debugging; some resolvers respond by trying another server.</string>

    <!-- Settings: upstream resolver -->
    <string name="settings_upstream_title">Resolver</string>
    <string name="settings_upstream_hint">Where lookups Malachi allows are sent.</string>
    <string name="upstream_system">Whatever the network provides</string>
    <string name="upstream_system_hint">Follows the Wi-Fi or mobile network you are on. The safest default.</string>
    <string name="upstream_cloudflare">Cloudflare</string>
    <string name="upstream_google">Google</string>
    <string name="upstream_quad9">Quad9</string>
    <string name="upstream_adguard">AdGuard DNS</string>
    <string name="upstream_custom">Custom</string>
    <string name="upstream_custom_hint">Set your own resolver addresses.</string>
    <string name="upstream_custom_label">Addresses</string>
    <string name="upstream_custom_dialog_hint">IP addresses only, separated by commas. Host names are not accepted — resolving one would need the resolver you are configuring.</string>

    <!-- Settings: bypass guard -->
    <string name="settings_bypass_title">Apps that go around the filter</string>
    <string name="settings_bypass_hint">An app with a resolver hard-coded into it never asks the system which one to use. Catching those means routing those addresses through Malachi, which can break their other traffic.</string>
    <string name="bypass_off">Off</string>
    <string name="bypass_off_hint">Only lookups that follow the system resolver. Nothing can break because of Malachi.</string>
    <string name="bypass_system">Also this network\'s resolvers</string>
    <string name="bypass_system_hint">Catches apps that address the router or the carrier\'s resolver directly. Recommended.</string>
    <string name="bypass_public">Also well-known public resolvers</string>
    <string name="bypass_public_hint">Catches apps that hard-code 8.8.8.8 and the like. Their encrypted DNS will stop working, which is the point — and occasionally the problem.</string>

