    <!-- About -->
    <string name="about_version">Version %1$s (build %2$d)</string>
    <string name="about_tagline">A DNS-level ad and tracker blocker. It runs as a local VPN that carries nothing but DNS: no traffic leaves the phone through Malachi, and nothing is sent anywhere.</string>
    <string name="about_limits_title">What it cannot block</string>
    <string name="about_limit_doh">Apps using encrypted DNS (DoH or DoT) of their own, unless the bypass guard is set high enough to cut them off.</string>
    <string name="about_limit_hardcoded_ip">Content fetched from an IP address with no lookup at all.</string>
    <string name="about_limit_in_page">Ads served from the same domain as the content around them — DNS cannot tell the two apart.</string>
    <string name="about_limit_one_vpn">Anything, while another VPN app is running. Android allows only one.</string>
    <string name="about_source_title">Source</string>
    <string name="about_repository">Code and releases</string>

