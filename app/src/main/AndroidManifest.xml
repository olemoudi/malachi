<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Downloading the blocklists and Malachi's own updates. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading the underlying network's resolvers and attributing a lookup to an app. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The per-app screen has to be able to name every app that can hold a connection,
         including the background services that never appear in the launcher. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- There is no foreground-service type for a VPN, and specialUse is the documented path. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Sideloaded distribution: the app installs its own updates (see update/Updater). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- allowBackup off: the settings hold the user's own rules and the list of apps they have
         exempted, which is a fairly precise description of what they use their phone for.
         Restoring it onto another device would also restore a filter that isn't running. -->
    <application
        android:name=".MalachiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Malachi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Malachi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The filter. BIND_VPN_SERVICE is what stops anything but the system starting it. -->
        <service
            android:name=".net.MalachiVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="dns_ad_filtering" />
        </service>

        <!-- Brings the filter back after a reboot, and after Malachi replaces itself. -->
        <receiver
            android:name=".net.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
